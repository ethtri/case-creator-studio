#!/usr/bin/env sh

set -e

# Local guardrail only. CI is authoritative.
npm run lint --if-present

echo "Checking for common issues..."

if git diff --cached --name-only | grep -q "^\.env$"; then
  echo "ERROR: .env file is being committed."
  echo "Please remove .env from your commit."
  exit 1
fi

if git diff --cached --name-only | grep -q "node_modules"; then
  echo "ERROR: node_modules is being committed."
  echo "Please remove node_modules from your commit."
  exit 1
fi

if git diff --cached --name-only | grep -q "^dist"; then
  echo "WARNING: dist folder is being committed."
  echo "Consider removing dist from the commit."
fi

echo "Pre-commit checks passed."
