{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/catalog",
      "destination": "/catalog/index.html"
    },
    {
      "source": "/catalog/",
      "destination": "/catalog/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
