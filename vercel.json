{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/go/pinterest",
      "destination": "/gifts/custom-phone-case?utm_source=pinterest&utm_medium=organic_social&utm_campaign=pinterest_profile",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/catalog",
      "destination": "/catalog/index.html"
    },
    {
      "source": "/catalog/",
      "destination": "/catalog/index.html"
    },
    {
      "source": "/custom-phone-case",
      "destination": "/custom-phone-case/index.html"
    },
    {
      "source": "/custom-phone-case/",
      "destination": "/custom-phone-case/index.html"
    },
    {
      "source": "/custom-iphone-case",
      "destination": "/custom-iphone-case/index.html"
    },
    {
      "source": "/custom-iphone-case/",
      "destination": "/custom-iphone-case/index.html"
    },
    {
      "source": "/custom-samsung-case",
      "destination": "/custom-samsung-case/index.html"
    },
    {
      "source": "/custom-samsung-case/",
      "destination": "/custom-samsung-case/index.html"
    },
    {
      "source": "/gifts/custom-phone-case",
      "destination": "/gifts/custom-phone-case/index.html"
    },
    {
      "source": "/gifts/custom-phone-case/",
      "destination": "/gifts/custom-phone-case/index.html"
    },
    {
      "source": "/phone-cases/:variantSlug",
      "destination": "/phone-cases/:variantSlug/index.html"
    },
    {
      "source": "/phone-cases/:variantSlug/",
      "destination": "/phone-cases/:variantSlug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
